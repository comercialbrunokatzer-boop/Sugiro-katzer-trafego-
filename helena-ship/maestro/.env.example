# ═══ MAESTRO — variaveis de ambiente (NENHUMA credencial no codigo) ═══
# Copie para .env (local) ou configure no painel do Netlify.

# ── Bitrix24 — ESCRITA (isolada do Auditor, que continua somente-leitura) ──
# Webhook com escopo de ESCRITA: crm.deal.add/update, crm.contact.add, crm.activity.add,
# crm.duplicate.findbycomm, crm.deal.list, crm.contact.list.
BITRIX_WEBHOOK_WRITE=

# ── Firebase (estado + memoria dos leads da Helena) ──
# RTDB via REST. URL do banco + (opcional) token/secret.
FIREBASE_DATABASE_URL=
FIREBASE_DB_SECRET=

# ── Z-API (WhatsApp — resposta ao lead) ──
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ── Discadora (fila de ligacao) ──
# Se a discadora puxa direto do Bitrix, deixe DISCADORA_MODE=bitrix (nada a fazer).
# Se tem API propria, DISCADORA_MODE=api e preencha o endpoint.
DISCADORA_MODE=bitrix
DISCADORA_API_URL=
DISCADORA_API_TOKEN=

# ── Alerta de falha (WhatsApp pro Katzer) ──
KATZER_ALERT_PHONE=

# ── Etapas do funil (CONFIRMAR com o CEO quais representam cada nivel) ──
# Padroes seguros; troque quando confirmar no Bitrix.
STAGE_LEAD_NOVO=C1:NEW
STAGE_QUALIFICADO=C1:PREPARATION
STAGE_PRE_QUALIFICADO=C1:PREPARATION
BITRIX_CATEGORY_ID=1

# ── Campos customizados que o Auditor AINDA nao mapeia (preencher com o ID do Bitrix) ──
# Deixe vazio para NAO enviar o campo (melhor vazio do que errado).
UF_ORIGEM=
UF_PERFIL_DECISOR=
UF_NIVEL=
UF_EMAIL_EXTRA=

# ── Pool de corretores para round-robin (IDs do Bitrix, separados por virgula) ──
# Padrao: os 3 do foco (Edsel 985, Elyas 1637, Leandro 1613). Ajuste conforme a escala real.
BROKER_POOL=985,1637,1613

# ── Modo de operacao ──
# 'producao' escreve no Bitrix de verdade. 'homolog' SIMULA (loga o que escreveria) — teste sem risco.
MAESTRO_MODO=producao
